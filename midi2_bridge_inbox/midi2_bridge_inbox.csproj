<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Midi2BridgeInbox</RootNamespace>
    <AssemblyName>midi2_bridge_inbox</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <!-- The in-box preview 9 package isn't on nuget.org; vendor/ holds the nupkg from
         https://github.com/microsoft/MIDI/releases/tag/inbox-dev-preview-9 -->
    <RestoreSources>$(MSBuildThisFileDirectory)vendor;https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>

  <PropertyGroup>
    <CSWinRTInputs>Windows.Devices.Midi2</CSWinRTInputs>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.83-devpreview.9" />
  </ItemGroup>

</Project>
