<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Midi2Bridge</RootNamespace>
    <AssemblyName>midi2_bridge</AssemblyName>
    <!-- We reference the Windows.Devices.Midi2 .NET projection DLL straight out of the
         official Microsoft.Windows.Devices.Midi2 nupkg (downloaded from
         https://github.com/microsoft/MIDI/releases, tag rc-3) rather than a NuGet feed,
         since that package isn't published to nuget.org. -->
    <SelfContained>false</SelfContained>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Windows.Devices.Midi2.NetProjection">
      <HintPath>vendor\Microsoft.Windows.Devices.Midi2.NetProjection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
